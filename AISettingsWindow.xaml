<Window x:Class="PeachOCR.AISettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PeachOCR"
        mc:Ignorable="d"
        Title="设置" Height="600" Width="800" MinWidth="750" MinHeight="550"
        Background="#1E1E1E" WindowStartupLocation="CenterOwner"
        WindowStyle="ToolWindow">

    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI, Microsoft YaHei, Arial"/>
            <Setter Property="Foreground" Value="#E0E0E0"/>
        </Style>

        <Style TargetType="Button" x:Key="PrimaryButton">
            <Setter Property="FontFamily" Value="Segoe UI, Microsoft YaHei, Arial"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="#2196f3"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                BorderThickness="0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1E88E5"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="Button" x:Key="SecondaryButton" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="#424242"/>
            <Setter Property="Foreground" Value="#E0E0E0"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#555"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="Border" x:Key="CardStyle">
            <Setter Property="Background" Value="#2D2D2D"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#3E3E3E"/>
            <Setter Property="Margin" Value="0,0,0,15"/>
            <Setter Property="Padding" Value="15"/>
        </Style>

        <Style TargetType="TextBlock" x:Key="SectionTitle">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="Foreground" Value="#2196f3"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="FontFamily" Value="Segoe UI, Microsoft YaHei, Arial"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="#E0E0E0"/>
            <Setter Property="Background" Value="#333"/>
            <Setter Property="BorderBrush" Value="#555"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Margin" Value="0,5,0,10"/>
        </Style>

        <Style TargetType="PasswordBox">
            <Setter Property="FontFamily" Value="Segoe UI, Microsoft YaHei, Arial"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="#E0E0E0"/>
            <Setter Property="Background" Value="#333"/>
            <Setter Property="BorderBrush" Value="#555"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Margin" Value="0,5,0,10"/>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="FontFamily" Value="Segoe UI, Microsoft YaHei, Arial"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="#E0E0E0"/>
            <Setter Property="Background" Value="#333"/>
            <Setter Property="BorderBrush" Value="#555"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,5,0,10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton"
                                          Background="{TemplateBinding Background}"
                                          BorderBrush="{TemplateBinding BorderBrush}"
                                          BorderThickness="1"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="20"/>
                                    </Grid.ColumnDefinitions>
                                    <ContentPresenter Grid.Column="0" Content="{TemplateBinding SelectionBoxItem}"
                                                      Margin="8,0,0,0" VerticalAlignment="Center"/>
                                    <Path Grid.Column="1" Data="M0,0 L4,4 8,0" Stroke="#A0A0A0" StrokeThickness="1"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>
                            </ToggleButton>
                            <Popup x:Name="Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True" Focusable="False" PopupAnimation="Slide">
                                <Border Background="#333" BorderBrush="#555" BorderThickness="1" CornerRadius="4">
                                    <ScrollViewer MaxHeight="200">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#E0E0E0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="8,4"/>
            <Style.Triggers>
                <Trigger Property="IsHighlighted" Value="True">
                    <Setter Property="Background" Value="#444"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#3A3A3A"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="Label">
            <Setter Property="FontFamily" Value="Segoe UI, Microsoft YaHei, Arial"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="#E0E0E0"/>
            <Setter Property="Margin" Value="0,5,0,0"/>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="设置"
                   FontSize="20" FontWeight="Bold"
                   Foreground="#2196f3"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,20"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="服务提供商配置" Style="{StaticResource SectionTitle}"/>

                        <Label Content="服务提供商："/>
                        <ComboBox x:Name="ComboServiceProvider" SelectedIndex="0" SelectionChanged="ComboServiceProvider_SelectionChanged">
                            <ComboBoxItem Content="OpenAI兼容"/>
                            <ComboBoxItem Content="DeepSeek"/>
                        </ComboBox>

                        <Label Content="API地址："/>
                        <TextBox x:Name="TxtApiUrl" Text="https://api.openai.com/v1"/>

                        <Label Content="API密钥："/>
                        <StackPanel Orientation="Horizontal">
                            <PasswordBox x:Name="PwdApiKey" Width="600"/>
                            <Button x:Name="BtnToggleApiKey" Content="👁" Width="30" Height="28" Margin="5,5,0,10"
                                    Style="{StaticResource SecondaryButton}" Click="BtnToggleApiKey_Click"
                                    ToolTip="显示/隐藏密码"/>
                        </StackPanel>

                        <Label Content="模型名称："/>
                        <TextBox x:Name="TxtModelName" Text="gpt-3.5-turbo" ToolTip="对于DeepSeek，默认使用deepseek-v4-flash，您也可以输入其他支持的模型名称"/>

                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <Button x:Name="BtnTestConnection" Content="测试连接"
                                    Style="{StaticResource PrimaryButton}" Click="BtnTestConnection_Click"/>
                            <TextBlock x:Name="TxtConnectionStatus" Margin="10,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="AI OCR配置" Style="{StaticResource SectionTitle}"/>

                        <Label Content="OCR服务提供商："/>
                        <ComboBox x:Name="ComboOcrServiceProvider" SelectedIndex="0" IsEnabled="False">
                            <ComboBoxItem Content="PaddleOCR（在线）"/>
                        </ComboBox>

                        <Label Content="OCR API地址："/>
                        <TextBox x:Name="TxtOcrApiUrl" ToolTip="OCR服务商的API地址或JOB_URL"/>

                        <Label Content="API密钥："/>
                        <StackPanel Orientation="Horizontal">
                            <PasswordBox x:Name="PwdOcrApiKey" Width="600" ToolTip="OCR服务商的TOKEN或API密钥"/>
                            <Button x:Name="BtnToggleOcrApiKey" Content="👁" Width="30" Height="28" Margin="5,5,0,10"
                                    Style="{StaticResource SecondaryButton}" Click="BtnToggleOcrApiKey_Click"
                                    ToolTip="显示/隐藏密码"/>
                        </StackPanel>

                        <Label Content="OCR模型："/>
                        <TextBox x:Name="TxtOcrModel" ToolTip="OCR服务商支持的模型名称"/>

                        <TextBlock Text="推荐配置：\n• PaddleOCR（在线）：默认模型 PaddleOCR-VL-1.6"
                                   FontSize="12" Foreground="#A0A0A0" Margin="0,5,0,10" TextWrapping="Wrap"/>

                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <Button x:Name="BtnTestOcrConnection" Content="测试OCR连接"
                                    Style="{StaticResource PrimaryButton}" Click="BtnTestOcrConnection_Click"/>
                            <TextBlock x:Name="TxtOcrConnectionStatus" Margin="10,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="快捷键配置" Style="{StaticResource SectionTitle}"/>

                        <Label Content="截图OCR快捷键："/>
                        <StackPanel Orientation="Horizontal">
                            <TextBox x:Name="TxtScreenshotHotkey" Width="200" IsReadOnly="True"
                                     ToolTip="按下此组合键将直接进行截图OCR"/>
                            <Button x:Name="BtnCaptureHotkey" Content="点击设置" Width="100" Height="32" Margin="10,5,0,10"
                                    Style="{StaticResource SecondaryButton}" Click="BtnCaptureHotkey_Click"/>
                            <Button x:Name="BtnClearHotkey" Content="清除" Width="60" Height="32" Margin="5,5,0,10"
                                    Style="{StaticResource SecondaryButton}" Click="BtnClearHotkey_Click"/>
                        </StackPanel>
                        <TextBlock Text='提示：按下您想要的快捷键组合（如 Ctrl+Shift+Q），然后点击"点击设置"'
                                   FontSize="12" Foreground="#A0A0A0" Margin="0,5,0,10" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="保存文件类型配置" Style="{StaticResource SectionTitle}"/>

                        <Label Content="输出文件格式："/>
                        <ComboBox x:Name="ComboOutputFormat" SelectedIndex="0">
                            <ComboBoxItem Content="txt标准格式"/>
                            <ComboBoxItem Content="md文件"/>
                        </ComboBox>
                        <TextBlock Text="选择md文件后，输出的文件将是Markdown格式，双击识别结果区域可使用默认Markdown软件打开"
                                   FontSize="12" Foreground="#A0A0A0" Margin="0,5,0,10" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="AI提示词配置" Style="{StaticResource SectionTitle}"/>

                        <Label Content="OCR增强提示词："/>
                        <TextBox x:Name="TxtOcrEnhancementPrompt" Height="100" TextWrapping="Wrap"
                                 AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/>

                        <Label Content="分析总结提示词："/>
                        <TextBox x:Name="TxtAnalysisPrompt" Height="100" TextWrapping="Wrap"
                                 AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/>

                        <Label Content="翻译提示词："/>
                        <TextBox x:Name="TxtTranslationPrompt" Height="100" TextWrapping="Wrap"
                                 AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
            <Button x:Name="BtnSave" Content="保存" Style="{StaticResource PrimaryButton}" Width="100" Click="BtnSave_Click"/>
            <Button x:Name="BtnCancel" Content="取消" Style="{StaticResource SecondaryButton}" Width="100" Click="BtnCancel_Click"/>
            <Button x:Name="BtnReset" Content="重置默认" Style="{StaticResource SecondaryButton}" Width="100" Click="BtnReset_Click"/>
        </StackPanel>
    </Grid>
</Window>
